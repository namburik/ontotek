# Used by scripts/sync_from_openmetadata.py (to read live allowed_values)
# and by db/ontotek_schema.sql's role. server.py itself no longer connects
# to Postgres directly — it queries Cube instead (see CUBE_API_URL below),
# and Cube holds its own copy of this same credential in cube/.env.
POSTGRES_READ_ONLY_URI=postgresql://ontotek_reader:PASSWORD@localhost:5432/mltek

# OpenMetadata (catalog/lineage layer) — used only by openmetadata/*.py and
# scripts/sync_from_openmetadata.py, not by server.py itself.
OPENMETADATA_HOST_PORT=http://localhost:8585/api
OPENMETADATA_JWT_TOKEN=REPLACE_WITH_INGESTION_BOT_TOKEN
OPENMETADATA_DB_SERVICE_NAME=mltek_ontotek

# Only needed when rendering openmetadata/postgres_ingestion.yaml.tmpl and
# alpha_ingestion.yaml.tmpl, and for cube/.env (see cube/docker-compose.yml).
ONTOTEK_READER_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD

SIFTTEK_DB_PASSWORD=REPLACE_WITH_SIFTTEK_DB_PASSWORD

# Least-privilege reader role for the separate `sifttek` Postgres database
# (see db/sifttek_reader.sql). Used by Cube's second datasource (docker-compose.yml)
# and by scripts/sync_from_openmetadata.py to read live allowed_values for
# sifttek-sourced dimensions.
SIFTTEK_READER_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
SIFTTEK_READ_ONLY_URI=postgresql://sifttek_reader:PASSWORD@localhost:5432/sifttek

# Cube (semantic layer / query compiler) — server.py's compile_and_execute_intent
# calls this instead of building SQL itself. CUBEJS_API_SECRET must match the
# value in cube/.env; unused while Cube runs in dev mode (auth disabled) but
# kept so switching dev mode off doesn't silently break the tool.
CUBE_API_URL=http://localhost:4000/cubejs-api/v1
CUBEJS_API_SECRET=REPLACE_WITH_GENERATED_SECRET

# Local Ollama (NL -> intent agent + answer synthesis, app/ontotek_agent.py).
# qwen2.5-coder:3b specifically — see that file's module docstring for why
# (qwen3.5:2b's thinking mode conflicts with schema-constrained decoding).
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_BASE_URL=http://localhost:11434
